# Render Free / Phase 1 defaults
VTON_PROVIDER=mock
DISABLE_REMBG=true
PUBLIC_BACKEND_URL=https://vton-mvp-api.onrender.com

# Replicate / Phase 2 optional real VTON provider
# VTON_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL=
REPLICATE_VERSION=
REPLICATE_POLL_TIMEOUT_SECONDS=180
REPLICATE_POLL_INTERVAL_SECONDS=3

# Generic fallback provider
VTON_API_URL=
VTON_API_KEY=
