# Render Free defaults with Replicate fallback.
# In auto mode the backend uses Replicate when REPLICATE_API_TOKEN and
# REPLICATE_MODEL/REPLICATE_VERSION exist; otherwise it falls back to mock.
VTON_PROVIDER=auto
DISABLE_REMBG=true
PUBLIC_BACKEND_URL=https://vton-mvp-api.onrender.com
VTON_DRAW_FIT_LABELS=false
VTON_USE_HUMANIZED_PERSON=true
VTON_REPLACE_MOCK_PERSON_FOR_EXTERNAL=true
VTON_MOCK_BODY_STYLE=premium_gray
VTON_HUMAN_TEMPLATE_PATH=
VTON_HUMAN_TEMPLATE_DIR=app/assets/human_templates
UPLOAD_GC_DELAY_SECONDS=1800
PERSON_EPHEMERAL_TTL_SECONDS=1200

# Replicate real VTON provider
REPLICATE_API_TOKEN=
REPLICATE_MODEL=cuuupid/idm-vton
REPLICATE_VERSION=
REPLICATE_INPUT_SCHEMA=idm-vton
REPLICATE_STEPS=30
REPLICATE_AUTO_CROP=false
REPLICATE_FORCE_DC=false
REPLICATE_MASK_ONLY=false
REPLICATE_CREATE_MAX_RETRIES=2
REPLICATE_POLL_TIMEOUT_SECONDS=180
REPLICATE_POLL_INTERVAL_SECONDS=3

# Hugging Face Spaces fallback provider
HF_API_TOKEN=
HF_SPACE_ID=Pinhoabacaxi/IDM-VTON
HF_SPACE_API_NAME=/tryon
HF_DENOISE_STEPS=30
HF_SEED=42
HF_GARMENT_DESCRIPTION=clothing item for virtual try-on
HF_IS_CHECKED_CROP=false
HF_NORMALIZE_INPUTS=true
HF_PERSON_WIDTH=768
HF_PERSON_HEIGHT=1024
HF_SKIP_FOR_MOCK_PERSON=false
HF_REJECT_SIMPLE_PERSON=true
HF_IMAGE_MAX_BYTES=2097152

# Generic fallback provider
VTON_API_URL=
VTON_API_KEY=
